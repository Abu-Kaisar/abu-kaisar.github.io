      <!-- Research Themes & Interests -->
      <section class="content-section" id="interests">
        <div class="section-title-wrapper">
          <h2 class="section-title">🔍 Research Interests & Core Themes</h2>
        </div>

        <div class="research-grid">
          <div class="research-card">
            <div class="research-card-icon">🌪️</div>
            <h3 class="research-card-title">Biomimetic Aerodynamics</h3>
            <p class="research-card-desc">Leading-edge protuberances, tubercle-modified airfoils, corrugated wing sections, and vortex generators inspired by marine biology and avian kinematics.</p>
          </div>

          <div class="research-card">
            <div class="research-card-icon">💻</div>
            <h3 class="research-card-title">Computational Fluid Dynamics</h3>
            <p class="research-card-desc">High-resolution RANS (SST $k-\omega$, Transition SST) and URANS simulations utilizing ANSYS Fluent, CFX, and OpenFOAM running on HPC clusters.</p>
          </div>

          <div class="research-card">
            <div class="research-card-icon">📈</div>
            <h3 class="research-card-title">Aerodynamic Optimization</h3>
            <p class="research-card-desc">Design of Experiments (DOE), Response Surface Methodology (RSM), Genetic Algorithms, and surrogate modeling for multi-objective aerodynamic design.</p>
          </div>

          <div class="research-card">
            <div class="research-card-icon">💨</div>
            <h3 class="research-card-title">Wind Turbine Aerodynamics</h3>
            <p class="research-card-desc">Airfoil blending and flow control for low-speed Vertical Axis Wind Turbines (VAWTs) to elevate starting torque and aerodynamic power coefficients.</p>
          </div>

          <div class="research-card">
            <div class="research-card-icon">🌊</div>
            <h3 class="research-card-title">Marine Hydrodynamics</h3>
            <p class="research-card-desc">Hydrodynamic drag reduction, hull form modifications, and flow visualization for autonomous Slocum underwater gliders.</p>
          </div>

          <div class="research-card">
            <div class="research-card-icon">♻️</div>
            <h3 class="research-card-title">Sustainable Energy & E-Waste</h3>
            <p class="research-card-desc">Material flow analysis, environmental risk assessment of e-waste recycling, and municipal solid waste-to-energy conversion systems.</p>
          </div>
        </div>
      </section>

